{
  "name": "@mm/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/server.ts src/admin/cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs --packages=external --alias:@mm/shared=../shared/src/index.ts",
    "admin": "tsx src/admin/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:prod": "esbuild src/server.ts src/admin/cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist-prod --out-extension:.js=.mjs --alias:@mm/shared=../shared/src/index.ts --minify-syntax --legal-comments=none --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@mm/shared": "*",
    "fastify": "^5.12.8",
    "libsodium-wrappers-sumo": "^0.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
